{
  // ===== LaTeX Workshop 实时预览配置 =====
  // 效果：编辑 main_*.tex 时自动重新编译，右侧 PDF 标签页自动刷新。

  // 编译产物按模板分目录放到 .preview/<模板名>/，并保留 SyncTeX 文件。
  "latex-workshop.latex.outDir": ".preview/%DOC%",

  // 停止输入约 800ms 后触发单遍预览；发布时再使用 scripts/build.py release。
  "latex-workshop.latex.autoBuild.run": "onChange",
  "latex-workshop.latex.autoBuild.interval": 800,

  // LaTeX 源码只做视觉软换行，不在保存时自动改写文件。
  "[latex]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "editor.wrappingIndent": "indent",
    "editor.wrappingStrategy": "advanced",
    "editor.rulers": [100, 120],
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },

  // 单遍 XeLaTeX 预览，保留 PDF <-> 源码定位所需的 .synctex.gz。
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex-preview-fast",
      "command": "xelatex",
      "args": [
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-no-shell-escape",
        "-synctex=1",
        "-output-directory=.preview/%DOC%",
        "%DOC%.tex"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex-preview-fast",
      "tools": ["xelatex-preview-fast"]
    }
  ],
  "latex-workshop.latex.recipe.default": "xelatex-preview-fast",

  // 忽略主文档中的 % !TeX program，避免退回默认 recipe 污染根目录。
  "latex-workshop.latex.build.forceRecipeUsage": true,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.message.banner": false,
  "latex-workshop.latex.autoClean.run": "never"
}
