root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.tex]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,jsonc,md,yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 120
