% 通用教育背景模板：填写真实信息请复制本文件为 education.tex（该文件已被 .gitignore 忽略，不会提交到仓库）。
\newcommand{\ResumeGraduateSchool}{你的学校}
\newcommand{\ResumeGraduateMajor}{你的专业}
\newcommand{\ResumeGraduateDegree}{硕士}
\newcommand{\ResumeGraduateDate}{xxxx.xx--xxxx.xx}
\newcommand{\ResumeGraduateAwards}{奖项 $\times$ N}

\newcommand{\ResumeUndergraduateSchool}{你的学校}
\newcommand{\ResumeUndergraduateMajor}{你的专业}
\newcommand{\ResumeUndergraduateDegree}{本科}
\newcommand{\ResumeUndergraduateDate}{xxxx.xx--xxxx.xx}
\newcommand{\ResumeUndergraduateAwards}{奖项；GPA: x.x/x.x}

\newcommand{\ResumeEducationBlock}{%
    {\textbf{\ResumeGraduateSchool}}，\ResumeGraduateMajor，\textit{\ResumeGraduateDegree} \hfill \ResumeGraduateDate
    \begin{itemize}
        \item \textbf{荣誉奖项}：\ResumeGraduateAwards
    \end{itemize}

    \vspace{0.2em}
    {\textbf{\ResumeUndergraduateSchool}}，\ResumeUndergraduateMajor，\textit{\ResumeUndergraduateDegree} \hfill \ResumeUndergraduateDate
    \begin{itemize}
        \item \textbf{荣誉奖项}：\ResumeUndergraduateAwards
    \end{itemize}
}
